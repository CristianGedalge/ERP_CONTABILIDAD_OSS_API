# .env.example — plantilla de variables de entorno
# Copia este archivo a `.env` y completa los valores locales.
# NO comites `.env` con secretos reales.

# Base de datos PostgreSQL
# Formato: jdbc:postgresql://<host>:<port>/<database>
DB_URL=jdbc:postgresql://localhost:5432/ERP_CONTABLE_OSS_DB
DB_USERNAME=postgres
DB_PASSWORD=changeme

# JWT (usar una clave Base64 larga en producción)
# Puedes generar una clave base64: openssl rand -base64 48
JWT_SECRET=change_this_base64_secret
JWT_EXPIRATION_MS=3600000

# Spring profile opcional: si quieres forzar el perfil local
# SPRING_PROFILES_ACTIVE=local

# Otros ajustes opcionales (ejemplos)
# SERVER_PORT=8080
# LOG_LEVEL=DEBUG
